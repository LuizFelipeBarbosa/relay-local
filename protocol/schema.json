{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relay:protocol:v1",
  "title": "Relay host protocol v1",
  "description": "Additional byte limits, sequence, deadline and identity invariants are specified in docs/protocol.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "enum": [
        "hello",
        "welcome",
        "catalog",
        "heartbeat",
        "heartbeat_ack",
        "request",
        "response_start",
        "response_chunk",
        "response_end",
        "error",
        "cancel"
      ]
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "backend_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "agent_version": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "arch": {
      "type": "string"
    },
    "heartbeat_id": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "start_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "body": {
      "type": "object"
    },
    "status": {
      "type": "integer",
      "minimum": 200,
      "maximum": 599
    },
    "content_type": {
      "enum": [
        "application/json",
        "text/event-stream"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "string",
      "minLength": 4,
      "maxLength": 43692,
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "retryable": {
      "type": "boolean"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backends": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/backend"
      }
    }
  },
  "$defs": {
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "ready",
        "capacity",
        "available",
        "models"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ollama",
            "cliproxyapi"
          ]
        },
        "source": {
          "enum": [
            "local",
            "provider"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "available": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "models": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ollama"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "local"
              },
              "models": {
                "items": {
                  "required": [
                    "digest"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "source": {
                "const": "provider"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "required": [
          "host_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "welcome"
          }
        }
      },
      "then": {
        "required": [
          "host_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "catalog"
          }
        }
      },
      "then": {
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "heartbeat"
          }
        }
      },
      "then": {
        "required": [
          "heartbeat_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "heartbeat_ack"
          }
        }
      },
      "then": {
        "required": [
          "heartbeat_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request"
          }
        }
      },
      "then": {
        "required": [
          "request_id",
          "attempt_id",
          "backend_id",
          "model",
          "timeout_ms",
          "start_timeout_ms",
          "body"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "response_start"
          }
        }
      },
      "then": {
        "required": [
          "attempt_id",
          "status",
          "content_type"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "response_chunk"
          }
        }
      },
      "then": {
        "required": [
          "attempt_id",
          "seq",
          "data"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "response_end"
          }
        }
      },
      "then": {
        "required": [
          "attempt_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "attempt_id",
          "code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cancel"
          }
        }
      },
      "then": {
        "required": [
          "attempt_id"
        ]
      }
    }
  ]
}
